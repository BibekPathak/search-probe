<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="api-key" content="<%= ENV.fetch('DASHBOARD_API_KEY', 'dev-key') %>">
  <title>SearchProbe</title>
  <style>
    :root {
      --bg: #0f172a; --panel: #1e293b; --panel-2: #334155; --text: #e2e8f0;
      --muted: #94a3b8; --accent: #38bdf8; --good: #4ade80; --bad: #f87171;
      --warn: #fbbf24; --border: #334155;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text);
           font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    header { padding: 18px 28px; border-bottom: 1px solid var(--border);
             display: flex; align-items: baseline; gap: 14px; }
    h1 { font-size: 18px; margin: 0; color: var(--accent); letter-spacing: 0.5px; }
    header .sub { color: var(--muted); }
    main { padding: 24px 28px; max-width: 1100px; margin: 0 auto; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
    .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
    .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; }
    .card .value { font-size: 26px; margin-top: 6px; font-weight: 600; }
    .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
             padding: 16px; margin-top: 18px; }
    .panel h2 { margin: 0 0 12px; font-size: 14px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.6px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 500; font-size: 12px; text-transform: uppercase; }
    tr:last-child td { border-bottom: none; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; }
    .pill.success { background: rgba(74,222,128,.15); color: var(--good); }
    .pill.failure { background: rgba(248,113,113,.15); color: var(--bad); }
    .pill.http { background: rgba(56,189,248,.15); color: var(--accent); }
    .pill.browser { background: rgba(167,139,250,.2); color: #c4b5fd; }
    .pill.cache { background: rgba(251,191,36,.15); color: var(--warn); }
    .err { color: var(--bad); }
    .muted { color: var(--muted); }
    .refresh-note { color: var(--muted); font-size: 12px; margin-left: auto; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
